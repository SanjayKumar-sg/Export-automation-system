# ============================================================
#  Export Automation System - Environment Variables Template
#  Copy this file to .env and fill in your values
# ============================================================

# Flask
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me-to-a-very-long-random-string-at-least-32-chars

# Database
DATABASE_URL=sqlite:///export_automation.db

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key
# Gmail SMTP
GMAIL_SENDER=sanjaykumarsg13@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Email Settings
MAIL_DEFAULT_SENDER=your-email@gmail.com
DAILY_SEND_LIMIT=200
SEND_DELAY_SECONDS=3

# Search Settings
DEFAULT_KEYWORD=Singing Bowls
MAX_SEARCH_RESULTS=100

# File Upload
MAX_UPLOAD_MB=10
UPLOAD_FOLDER=app/assets

# Security
WTF_CSRF_ENABLED=True
SESSION_COOKIE_SECURE=False

# Admin Account (auto-created on first run)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@1234

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs
